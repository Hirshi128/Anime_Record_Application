{
  "name": "anime_record",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run prisma:generate && next build",
    "start": "next start",
    "start:lan": "next start --hostname 0.0.0.0",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "playwright test",
    "test:browser:auth": "playwright test --config playwright.auth.config.ts",
    "test:browser:personal": "playwright test --config playwright.personal.config.ts",
    "verify": "node scripts/verify.mjs",
    "db:init": "node scripts/init-db.mjs",
    "db:migrate": "prisma migrate deploy",
    "users:provision": "node scripts/provision-legacy-user.mjs",
    "data:export-sqlite": "node scripts/export-sqlite-data.mjs",
    "data:import-postgres": "node scripts/import-postgres-data.mjs",
    "data:migrate-to-postgres": "npm run data:export-sqlite && npm run data:import-postgres",
    "prisma:generate": "prisma generate",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@neondatabase/serverless": "^1.1.0",
    "@prisma/adapter-better-sqlite3": "^7.9.0",
    "@prisma/adapter-neon": "^7.10.0",
    "@prisma/client": "^7.9.0",
    "better-sqlite3": "^13.0.1",
    "dotenv": "^17.4.2",
    "lucide-react": "^1.49.0",
    "next": "16.3.8",
    "prisma": "^7.9.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.4.3",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "jsdom": "^30.1.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
