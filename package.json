{
  "name": "anime_record",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run prisma:generate && next build",
    "start": "next start",
    "start:lan": "next start --hostname 0.0.0.0",
    "lint": "eslint",
    "db:init": "node scripts/init-db.mjs",
    "db:migrate": "prisma migrate deploy",
    "data:export-sqlite": "node scripts/export-sqlite-data.mjs",
    "data:import-postgres": "node scripts/import-postgres-data.mjs",
    "data:migrate-to-postgres": "npm run data:export-sqlite && npm run data:import-postgres",
    "prisma:generate": "prisma generate",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@prisma/adapter-better-sqlite3": "^7.9.0",
    "@prisma/adapter-neon": "^7.10.0",
    "@prisma/client": "^7.9.0",
    "better-sqlite3": "^13.0.1",
    "dotenv": "^17.4.2",
    "next": "16.2.11",
    "prisma": "^7.9.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
